# ============================================================
# SignalSentry — LIVE NemoClaw + LangChain (primary path)
# ============================================================
# Run this from a NemoClaw sandbox (or host where inference.local
# is routed by OpenShell). Provider credentials stay on the host.

USE_MOCK_MODEL=false
MODEL_BASE_URL=https://inference.local/v1
MODEL_API_KEY=nemoclaw-local-placeholder
MODEL_NAME=nvidia/nemotron-mini

# json_schema | json_mode  (json_mode is a good fallback for some Nemotron routes)
STRUCTURED_OUTPUT_METHOD=json_schema

SEED=42

# ============================================================
# Offline fallback (CI / Streamlit Community Cloud only)
# ============================================================
# USE_MOCK_MODEL=true
